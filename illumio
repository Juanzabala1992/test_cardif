for ip in 10.171.98.202 10.171.199.2
do
  echo "=============================="
  echo "IP: $ip"
  echo "===== DNS ====="
  getent hosts "$ip"

  echo "===== PUERTOS ====="
  for port in 443 6443 22623
  do
    echo -n "$port: "
    timeout 3 bash -c "echo >/dev/tcp/$ip/$port" 2>/dev/null \
      && echo OPEN \
      || echo CLOSED/TIMEOUT
  done
done


for ip in 10.171.98.202 10.171.199.2
do
