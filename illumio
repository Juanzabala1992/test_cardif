echo "===== API EXTERNA ====="
oc get infrastructure cluster \
  -o jsonpath='{.status.apiServerURL}{"\n"}'

echo "===== API INTERNA ====="
oc get infrastructure cluster \
  -o jsonpath='{.status.apiServerInternalURI}{"\n"}'

echo "===== CONSOLE ====="
oc -n openshift-console get route console \
  -o jsonpath='{.spec.host}{"\n"}'

echo "===== INGRESS DOMAIN ====="
oc -n openshift-ingress-operator get ingresscontroller default \
  -o jsonpath='{.status.domain}{"\n"}'


API=$(oc get infrastructure cluster \
  -o jsonpath='{.status.apiServerURL}' \
  | sed -E 's#https://([^:/]+).*#\1#')

API_INT=$(oc get infrastructure cluster \
  -o jsonpath='{.status.apiServerInternalURI}' \
  | sed -E 's#https://([^:/]+).*#\1#')

CONSOLE=$(oc -n openshift-console get route console \
  -o jsonpath='{.spec.host}')

echo "===== API ====="
echo "$API"
getent ahostsv4 "$API" | awk '{print $1}' | sort -u

echo "===== API INTERNA ====="
echo "$API_INT"
getent ahostsv4 "$API_INT" | awk '{print $1}' | sort -u

echo "===== CONSOLE / INGRESS ====="
echo "$CONSOLE"
getent ahostsv4 "$CONSOLE" | awk '{print $1}' | sort -u


